generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Table unique pour les trois rôles (héritage : une table + colonne role).
// role vaut GERANT, MAGASINIER ou LIVREUR (validé avec Zod dans le code).
model Utilisateur {
  id                 Int       @id @default(autoincrement())
  nom                String
  identifiant        String    @unique
  motDePasseHash     String
  role               String
  actif              Boolean   @default(true)
  tentativesEchouees Int       @default(0)
  bloqueJusqua       DateTime?
  creeLe             DateTime  @default(now())
  affectations       Affectation[]
  mouvements         MouvementStock[]
  ajustementsDemandes AjustementStock[] @relation("AjustDemandeur")
  ajustementsDecides  AjustementStock[] @relation("AjustDecideur")
  camion              Camion?
  bonsDemandes        BonChargement[] @relation("BonLivreur")
  bonsControles       BonChargement[] @relation("BonMagasinier")
  bonsValides         BonChargement[] @relation("BonGerant")
  tournees            Tournee[]
}
model Categorie {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  produits Produit[]
}

model Produit {
  id              Int       @id @default(autoincrement())
  reference       String    @unique
  nom             String
  prix            Float
  piecesParCarton Int
  seuilMin        Int       @default(0)
  datePeremption  DateTime?
  archive         Boolean   @default(false)
  categorieId     Int
  categorie       Categorie @relation(fields: [categorieId], references: [id])
  mouvements      MouvementStock[]
  ajustements     AjustementStock[]
  lignesChargement LigneChargement[]
}
model Secteur {
  id           Int           @id @default(autoincrement())
  nom          String
  ville        String
  clients      Client[]
  affectations Affectation[]
  tournees     Tournee[]

  @@unique([nom, ville])
}

model Client {
  id          Int     @id @default(autoincrement())
  nomCommerce String
  responsable String
  telephone   String
  adresse     String
  secteurId   Int
  secteur     Secteur @relation(fields: [secteurId], references: [id])

  @@index([secteurId])
}

// Un livreur a un seul secteur par jour. jour = "AAAA-MM-JJ".
model Affectation {
  id        Int         @id @default(autoincrement())
  jour      String
  livreurId Int
  livreur   Utilisateur @relation(fields: [livreurId], references: [id])
  secteurId Int
  secteur   Secteur     @relation(fields: [secteurId], references: [id])

  @@unique([livreurId, jour])
}

// Journal des mouvements : on n'y modifie ni ne supprime jamais rien.
// variationPieces : + entrée, - sortie. Stock = somme des variations.
model MouvementStock {
  id              Int         @id @default(autoincrement())
  type            String      // ENTREE_FOURNISSEUR, AJUSTEMENT (d'autres suivront)
  variationPieces Int
  reference       String?     // n° du bon fournisseur
  motif           String?
  creeLe          DateTime    @default(now())
  produitId       Int
  produit         Produit     @relation(fields: [produitId], references: [id])
  auteurId        Int
  auteur          Utilisateur @relation(fields: [auteurId], references: [id])
  ajustement      AjustementStock?
  camionId        Int?            // vide = dépôt, sinon stock du camion
  camion          Camion?         @relation(fields: [camionId], references: [id])
  bonId           Int?
  bon             BonChargement?  @relation(fields: [bonId], references: [id])
  @@index([produitId])
}

// Demande de correction du stock : le magasinier propose, le gérant décide.
// Une fois validée, elle crée un mouvement AJUSTEMENT (le journal n'est jamais modifié).
model AjustementStock {
  id                Int          @id @default(autoincrement())
  variationPieces   Int          // + ajout, - retrait
  motif             String
  statut            String       @default("EN_ATTENTE") // EN_ATTENTE, VALIDE, REFUSE
  commentaireGerant String?
  creeLe            DateTime     @default(now())
  decideLe          DateTime?
  produitId         Int
  produit           Produit      @relation(fields: [produitId], references: [id])
  demandeParId      Int
  demandePar        Utilisateur  @relation("AjustDemandeur", fields: [demandeParId], references: [id])
  decideParId       Int?
  decidePar         Utilisateur? @relation("AjustDecideur", fields: [decideParId], references: [id])
  mouvementId       Int?         @unique
  mouvement         MouvementStock? @relation(fields: [mouvementId], references: [id])

  @@index([statut])
}

// Chaque livreur a son camion : un dépôt mobile avec son propre stock.
model Camion {
  id              Int          @id @default(autoincrement())
  immatriculation String       @unique
  livreurId       Int?         @unique
  livreur         Utilisateur? @relation(fields: [livreurId], references: [id])
  tournees        Tournee[]
  mouvements      MouvementStock[]
}

// Demande de recharge = bon de chargement du jour. Un bon par livreur et par jour.
// statut : BROUILLON, ENVOYE, CONTROLE, VALIDE, CHARGE, REFUSE
model BonChargement {
  id            Int          @id @default(autoincrement())
  jour          String       // jour de la tournée, "AAAA-MM-JJ"
  statut        String       @default("BROUILLON")
  commentaire   String?
  creeLe        DateTime     @default(now())
  envoyeLe      DateTime?
  controleLe    DateTime?
  valideLe      DateTime?
  chargeLe      DateTime?
  livreurId     Int
  livreur       Utilisateur  @relation("BonLivreur", fields: [livreurId], references: [id])
  controleParId Int?
  controlePar   Utilisateur? @relation("BonMagasinier", fields: [controleParId], references: [id])
  valideParId   Int?
  validePar     Utilisateur? @relation("BonGerant", fields: [valideParId], references: [id])

  lignes     LigneChargement[]
  mouvements MouvementStock[]
  tournee    Tournee?

  @@unique([livreurId, jour])
  @@index([statut])
}

// decision : EN_ATTENTE, ACCEPTEE, REJETEE. Quantités en pièces.
model LigneChargement {
  id               Int           @id @default(autoincrement())
  quantiteDemandee Int
  quantiteAccordee Int?
  decision         String        @default("EN_ATTENTE")
  motif            String?
  bonId            Int
  bon              BonChargement @relation(fields: [bonId], references: [id])
  produitId        Int
  produit          Produit       @relation(fields: [produitId], references: [id])

  @@unique([bonId, produitId])
}

// Créée quand le bon est chargé : le livreur peut alors commencer ses livraisons.
model Tournee {
  id        Int           @id @default(autoincrement())
  jour      String
  statut    String        @default("EN_COURS")
  livreurId Int
  livreur   Utilisateur   @relation(fields: [livreurId], references: [id])
  camionId  Int
  camion    Camion        @relation(fields: [camionId], references: [id])
  secteurId Int
  secteur   Secteur       @relation(fields: [secteurId], references: [id])
  bonId     Int           @unique
  bon       BonChargement @relation(fields: [bonId], references: [id])

  @@unique([livreurId, jour])
}